# --- chain ---
RH_CHAIN_ID=4663
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
MORPHO_VAULT_ADDRESS=0x37788ff0c1d4e45A7FE06BC7e71e0cc00121d0A8

# printed by contracts/script/DeployV1.s.sol
ROUND_V2_ADDRESS=
DEPOSIT_ROUTER_ADDRESS=
V1_DEPLOY_BLOCK=0

# --- hot keys (never commit real values) ---
# writes to the round ledger: registerAccount / recordWithdraw / recordRedeem / releaseLaunch
RECORDER_PRIVATE_KEY=
# tops up custodial accounts with eth for gas
GAS_FUNDER_PRIVATE_KEY=

# --- fee ---
FEE_RECIPIENT=0x1F6334dF3d6ef04d17d479529fe22472574F4433
FEE_BPS=1000

# --- key encryption ---
# `local` wraps data keys with KEK_HEX in-process. Only for dev and the demo; the kek must
# live outside the database and outside this repo. Swap for a kms provider before scaling.
KEY_PROVIDER=local
KEK_HEX=

# --- database ---
# local convention: docker container `either-pg` on :5433 (see README)
DATABASE_URL=postgres://either:either@127.0.0.1:5433/either

# --- api ---
PORT=8787
# origin allowed to call the api, i.e. where the web app is served from
CORS_ORIGIN=http://localhost:3000
# domain the sign-in message is bound to
SIWE_DOMAIN=localhost:3000

# --- executor ---
# confirmations to wait before acting on a deposit event
CONFIRMATIONS=3
# eth (wei) to keep on every custodial account; topped up when it falls below half
CUSTODIAL_GAS_TARGET_WEI=200000000000000
